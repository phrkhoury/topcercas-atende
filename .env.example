# Banco de dados local (SQLite)
DATABASE_URL="file:./dev.db"

# Primeiro administrador (criado automaticamente no primeiro login)
ADMIN_EMAIL="admin@topcercas.com.br"
ADMIN_PASSWORD="troque-esta-senha"

# Segredo para assinar a sessão (32+ caracteres aleatórios)
AUTH_SECRET=""

# Chave da API do Claude (https://platform.claude.com) — sem ela, a IA não responde
ANTHROPIC_API_KEY=""
# Modelo usado pela IA
AI_MODEL="claude-opus-5-5"

# WhatsApp Cloud API (opcional — deixe vazio para usar só o simulador)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Defina como 1 para desligar o envio automático de lembretes
DISABLE_SCHEDULER="0"
